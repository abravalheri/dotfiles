#!/usr/bin/env zsh
# vim: set foldmethod=marker filetype=zsh :
# Consider https://www.funtoo.org/Keychain in the future

local SSH_ENV="$HOME/.ssh/environment"
local AGENT_LIFETIME=3600

# Probe the agent for real: ssh-add -l exits 2 only when there is no agent,
# so a running-but-empty agent is not mistaken for a dead one.
ssh-agent-running() {
  (( ${+SSH_AUTH_SOCK} )) || return 1
  [[ -e $SSH_AUTH_SOCK ]] || return 1
  ssh-add -l &>/dev/null
  (( $? != 2 ))
}

if ! ssh-agent-running; then
  if [[ -r "$SSH_ENV" ]]; then
    eval "$(< "$SSH_ENV")" >/dev/null
  fi

  if ! ssh-agent-running; then  # Still cannot connect to agent
    rm -f "$SSH_ENV"
    (umask 066; ssh-agent -s -t "$AGENT_LIFETIME" > "$SSH_ENV")
    eval "$(< "$SSH_ENV")" >/dev/null
  fi
fi

echo -e "* $(tput setaf 6)ssh-agent$(tput sgr0) is running\n"
