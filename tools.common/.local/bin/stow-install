#!/usr/bin/env bash
set -Eeuo pipefail
# Layout-aware package installer dispatcher. Resolves a URL/path archive,
# verifies checksums, classifies the layout, and routes to the dedicated
# installer: stow-standard, stow-single-bin, stow-goreleased (or, for a
# relocatable prefix, tells the user to use opt-install unless --force-stow is
# given for a marker-less toolchain). Downloading + checksum verification is
# intrinsic for URL args (a dry-run resolves, verifies and plans without
# installing), so there is no separate --download flag.

PROG=stow-install
SHLIB="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/../lib/package-common.sh"
# shellcheck source=../lib/package-common.sh
source "$SHLIB"

trap 'rc=$?; printf "%s: ERROR line=%d rc=%d\n" "$PROG" "$LINENO" "$rc" >&2; exit "$rc"' ERR

main() {
    local verbose=0 dry=0 move=0 no_stow=0 keep_extras=0 scope=user
    local idir_opt= target_opt= name= version= force_stow=0 checksum=
    local archive= work dl local_archive readable base kind installer cmd
    IFS='|' read -r dry verbose move no_stow keep_extras scope idir_opt target_opt \
        name version force_stow checksum archive <<< "$(parse_flags "$@")"
    command -v tar  >/dev/null 2>&1 || die "tar not found"
    command -v stow-goreleased >/dev/null 2>&1 || die "stow-goreleased not found on PATH"
    command -v stow-standard   >/dev/null 2>&1 || die "stow-standard not found on PATH"
    command -v stow-single-bin >/dev/null 2>&1 || die "stow-single-bin not found on PATH"

    work=$(mktemp -d)
    # A URL archive is downloaded into a persistent temp dir (not $work) so the
    # file is still present when the sub-installer consumes it after $work is
    # cleaned below; resolve_archive keeps the original archive basename there.
    if [[ "$archive" =~ ^https?:// ]]; then
        dl=$(mktemp -d)
        local_archive=$(resolve_archive "$archive" "$checksum" "$dl")
    else
        local_archive=$(resolve_archive "$archive" "$checksum")
    fi
    readable=$(prepare_tar "$local_archive") || die "cannot decode '$archive': need zstd or Python zstandard"
    mkdir -p "$work/probe"
    tar -xf "$readable" -C "$work/probe" 2>/dev/null || die "cannot extract '$archive'"

    IFS='|' read -r kind base pm <<< "$(classify "$work/probe")"

    case "$kind" in
        goreleased)  installer=stow-goreleased ;;
        standard)    installer=stow-standard ;;
        single-bin)  installer=stow-single-bin ;;
        prefix)
            if (( force_stow )); then
                installer=stow-standard   # --force-stow honours the user's override
            else
                printf 'stow-install: %s is a relocatable prefix; use opt-install (dry-run: opt-install --dry-run <archive>)\n' "$(basename "$archive")" >&2
                exit 1
            fi ;;
        *)
            inform "unrecognised or empty archive layout" \
                "archive: $archive" \
                "kind: $kind" \
                "expected a standard (GoReleaser/FHS) tree, a single-executable tarball, or a relocatable prefix" ;;
    esac

    # Forward a version inferred from the original URL/path string (a pinned GitHub
    # release carries the version in the path even when the artifact has none).
    [ -n "$version" ] || version=$(infer_version "$archive" "$base" || true)

    cmd=("$installer")
    (( dry ))     && cmd+=(--dry-run)
    (( verbose )) && cmd+=(--verbose)
    (( move ))    && cmd+=(--move)
    (( no_stow )) && cmd+=(--no-stow)
    (( keep_extras )) && cmd+=(--keep-extras)
    (( force_stow )) && cmd+=(--force-stow)
    [ "$scope" = system ] && cmd+=(--system)
    [ -n "$idir_opt" ] && cmd+=(--install-dir "$idir_opt")
    [ -n "$target_opt" ] && cmd+=(--target "$target_opt")
    [ -n "$name" ]    && cmd+=(--name "$name")
    [ -n "$version" ] && cmd+=(--version "$version")
    cmd+=("$local_archive")
    rm -rf "$work"
    exec "${cmd[@]}"
}

main "$@"
