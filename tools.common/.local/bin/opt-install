#!/usr/bin/env bash
set -Eeuo pipefail
# Installer for relocatable self-contained prefixes (TinyTeX, Miniconda).
# The whole tree stays at $opt/<name>-<ver> so SelFAUT* / SELFAUTO root
# resolution keeps working; only a thin zshrc.d PATH shim is ever stowed.

PROG=opt-install
SHLIB="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/../lib/package-common.sh"
# shellcheck source=../lib/package-common.sh
source "$SHLIB"

trap 'rc=$?; printf "%s: ERROR line=%d rc=%d\n" "$PROG" "$LINENO" "$rc" >&2; exit "$rc"' ERR

main() {
    local opt=${STOW_INSTALL_ROOT:-$HOME/.local/opt}
    local name= version= checksum= dry_run=0 verbose=0 archive=
    local work local_archive readable base bindir bind_rel top stem
    while (($#)); do
        case "$1" in
            --dry-run)  dry_run=1; shift ;;
            --verbose|-v) verbose=1; shift ;;
            --name)     [ $# -ge 2 ] || die "--name requires a value"; name=$2; shift 2 ;;
            --name=*)   name=${1#--name=}; shift ;;
            --version)  [ $# -ge 2 ] || die "--version requires a value"; version=$2; shift 2 ;;
            --version=*) version=${1#--version=}; shift ;;
            --checksum) [ $# -ge 2 ] || die "--checksum requires a value"; checksum=$2; shift 2 ;;
            --checksum=*) checksum=${1#--checksum=}; shift ;;
            -*) die "unknown option: $1" ;;
            *) archive=$1; shift ;;
        esac
    done
    [ -n "$archive" ] || die "missing archive argument"
    command -v tar >/dev/null 2>&1 || die "tar not found"
    command -v stow >/dev/null 2>&1 || die "stow not found"

    work=$(mktemp -d)
    local_archive=$(resolve_archive "$archive" "$checksum")
    readable=$(prepare_tar "$local_archive") || die "cannot decode '$archive': need zstd or Python zstandard"
    mkdir -p "$work/stage"
    tar -xf "$readable" -C "$work/stage" 2>/dev/null || die "cannot extract '$archive'"

    IFS='|' read -r cls_kind base pm <<< "$(classify "$work/stage")"
    [ "$cls_kind" = prefix ] || die "not a relocatable prefix (kind=$cls_kind); use stow-install for this archive"

    stem=$(archive_stem "$(basename "$archive")")
    if [ -z "$name" ]; then
        name=$(derive_name "$(basename "$base")" 2>/dev/null || true)
    fi
    [ -z "$name" ] && name=${stem%%[-_]*}
    [ -n "$name" ] || die "unable to determine package name (pass --name)"

    if [ -z "$version" ]; then version=$(infer_version "$archive" "$base" || true); fi
    [ -n "$version" ] || die "unable to determine version (pass --version)"

    local versioned="$opt/$name-$version"
    if (( dry_run )); then
        printf 'would install %s %s\n' "$name" "$version"
        printf '  target: %s\n' "$versioned"
        [ -e "$versioned" ] && printf '  target already exists\n' || printf '  target free\n'
        printf '  would link ~/.config/zshrc.d/%s.zsh -> %s/.config/zshrc.d/%s.zsh\n' \
            "$name" "$versioned" "$name"
        rm -rf "$work"
        return 0
    fi
    [ -e "$versioned" ] && die "target already exists: $versioned"

    mkdir -p "$opt"
    mv "$base" "$versioned"
    if (( verbose )); then printf '%s: placed tree at %s\n' "$PROG" "$versioned"; fi

    # Auto-detect bin dir: <root>/bin, else <root>/bin/<platform>.
    bindir=
    if [ -d "$versioned/bin" ] && [ "$(find "$versioned/bin" -maxdepth 1 -type f -perm -u+x -print -quit 2>/dev/null)" ]; then
        bindir="$versioned/bin"
    else
        for top in "$versioned"/bin/*/ ; do
            [ -d "$top" ] || continue
            if [ "$(find "$top" -maxdepth 1 -type f -perm -u+x -print -quit 2>/dev/null)" ]; then
                bindir=${top%/}; break
            fi
        done
    fi
    [ -n "$bindir" ] || die "cannot locate executable bin dir under $versioned/bin"
    if (( verbose )); then printf '%s: bin dir %s\n' "$PROG" "$bindir"; fi

    # Thin, relocatable PATH shim (never the heavy binaries).
    bind_rel=${bindir#"$opt/"}
    mkdir -p "$versioned/.config/zshrc.d"
    {
        printf '# Generated by opt-install for %s %s\n' "$name" "$version"
        # $HOME and $PATH are written un-escaped (single-quoted format) so they
        # expand when the shim is sourced inside a user's zsh at startup.
        printf 'export PATH="$HOME/.local/opt/%s:$PATH"\n' "$bind_rel"
    } > "$versioned/.config/zshrc.d/$name.zsh"
    chmod +x "$versioned/.config/zshrc.d/$name.zsh"
    if (( verbose )); then printf '%s: wrote shim %s/.config/zshrc.d/%s.zsh\n' "$PROG" "$versioned" "$name"; fi

    printf '~\n' > "$versioned/.stow-target"
    write_ignore_list "$versioned" .config
    stow_pkg "$opt" "${versioned##*/}"
    refresh_zsh_cache
    if (( verbose )); then printf '%s: stowed shim and refreshed zsh cache\n' "$PROG"; fi
    printf 'installed %s %s\n' "$name" "$version"
    printf '  PATH shim: ~/.config/zshrc.d/%s.zsh -> %s\n' "$name" "$bindir"
    rm -rf "$work"
}

main "$@"
