#!/usr/bin/env bash
set -Eeuo pipefail
# Uninstall a versioned package: unstow every $opt/<name>-<ver> folder via
# stow-run (which uses the .stow-target marker), then remove the folders.

PROG=stow-uninstall
SHLIB="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/../lib/package-common.sh"
# shellcheck source=../lib/package-common.sh
source "$SHLIB"

trap 'rc=$?; printf "%s: ERROR line=%d rc=%d\n" "$PROG" "$LINENO" "$rc" >&2; exit "$rc"' ERR

main() {
    local opt scope=user name= dry_run=0 verbose=0
    local -a versioned=()
    local d pkg shim=0
    while (($#)); do
        case "$1" in
            --dry-run) dry_run=1; shift ;;
            --verbose|-v) verbose=1; shift ;;
            --system) scope=system; shift ;;
            --user) scope=user; shift ;;
            -*) die "unknown option: $1" ;;
            *) [ -z "$name" ] && name=$1 || die "unexpected extra argument: $1"; shift ;;
        esac
    done
    if [ "$scope" = system ]; then opt="${STOW_SYS_ROOT:-/usr/local}/opt"
    else opt="${STOW_INSTALL_ROOT:-$HOME/.local/opt}"; fi
    [ -n "$name" ] || die "missing package name"
    command -v stow-run >/dev/null 2>&1 || die "stow-run not found on PATH"

    shopt -s nullglob
    versioned=("$opt/$name-"[0-9]*)
    shopt -u nullglob
    if [ "${#versioned[@]}" -eq 0 ] && [ -d "$opt/$name" ]; then
        # Name-only dir (--no-shim, version-agnostic install).
        versioned=("$opt/$name")
    fi
    if [ "${#versioned[@]}" -eq 0 ]; then
        printf 'stow-uninstall: nothing installed for %s\n' "$name"
        return 0
    fi

    printf 'uninstalling %s\n' "$name"
    for d in "${versioned[@]}"; do
        pkg=${d##*/}
        [ -d "$d/.config/zshrc.d" ] && shim=1
        if [ -f "$d/.stow-target" ]; then
            if (( dry_run )); then printf '  would run: stow-run -d %s -D %s\n' "$opt" "$pkg"
            else
                if (( verbose )); then printf '  run: stow-run -d %s -D %s\n' "$opt" "$pkg"; fi
                stow-run -d "$opt" -D "$pkg"
            fi
        fi
        if (( dry_run )); then printf '  would remove: %s\n' "$d"
        else
            rm -rf "$d"
            if (( verbose )); then printf '  removed: %s\n' "$d"; fi
        fi
    done
    (( dry_run )) || {
        rmdir "$opt" 2>/dev/null || true
        if (( shim )); then refresh_zsh_cache; (( verbose )) && printf '  refreshed zsh cache\n'; fi
    }
    printf 'done\n'
}

main "$@"
