#!/usr/bin/env bash
set -Eeuo pipefail
# Installer for the flat GoReleaser shape: a binary at the root (or bin/)
# plus manpages/ and completions/. Those are reshaped into share/man and the
# shell-completion dirs via a file-level plan materialised with the shared
# deploy_entry helper: a symlink farm by default, real files with --move.

PROG=stow-goreleased
SHLIB="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/../lib/package-common.sh"
LEAFSHLIB="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/../lib/leaf-common.sh"
# shellcheck source=../lib/package-common.sh
source "$SHLIB"
# shellcheck source=../lib/leaf-common.sh
source "$LEAFSHLIB"

trap 'rc=$?; printf "%s: ERROR line=%d rc=%d\n" "$PROG" "$LINENO" "$rc" >&2; exit "$rc"' ERR

# Print the plan: binary -> bin/, manpages/* -> share/man/man1/, each completion
# file to its shell dir. One (src-rel key) pair per line.
goreleased_plan() {  # "$base"
    local base=$1 f b
    if [ -d "$base/bin" ]; then
        printf 'bin bin\n'
    else
        for f in "$base"/*; do
            [ -f "$f" ] && [ -x "$f" ] || continue
            b=$(basename "$f")
            printf '%s|%s\n' "$b" "bin/$b"
        done
    fi
    if [ -d "$base/manpages" ]; then
        for f in "$base/manpages"/man1/* "$base/manpages"/*; do
            [ -f "$f" ] || continue
            printf '%s|%s\n' "manpages/$(basename "$f")" "share/man/man1/$(basename "$f")"
        done
    fi
    if [ -d "$base/completions" ]; then
        for f in "$base/completions"/_* "$base/completions"/*.zsh; do
            [ -f "$f" ] || continue
            b=$(basename "$f"); case "$b" in *.zsh) b=_${b%.zsh} ;; esac
            printf '%s|%s\n' "completions/$(basename "$f")" "share/zsh/site-functions/$b"
        done
        for f in "$base/completions"/*.bash; do
            [ -f "$f" ] || continue
            printf '%s|%s\n' "completions/$(basename "$f")" "share/bash-completion/completions/$(basename "$f" .bash)"
        done
        for f in "$base/completions"/*.fish; do
            [ -f "$f" ] || continue
            printf '%s|%s\n' "completions/$(basename "$f")" "share/fish/vendor_completions.d/$(basename "$f")"
        done
    fi
}

main() { run_leaf goreleased GoReleaser goreleased_plan "$@"; }

main "$@"
