#!/usr/bin/env bash
set -Eeuo pipefail
# Installer for a single executable (optionally with sidecar helpers). The raw
# extracted files live under .orig/ and bin/<clean> links expose the executables
# under cleaned names (arch/version stripped); non-executables stay unlinked in
# .orig/. --move moves the executables straight to bin/<clean> instead.

PROG=stow-single-bin
SHLIB="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/../lib/package-common.sh"
LEAFSHLIB="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/../lib/leaf-common.sh"
# shellcheck source=../lib/package-common.sh
source "$SHLIB"
# shellcheck source=../lib/leaf-common.sh
source "$LEAFSHLIB"

trap 'rc=$?; printf "%s: ERROR line=%d rc=%d\n" "$PROG" "$LINENO" "$rc" >&2; exit "$rc"' ERR

# Clear a raw archive filename to its exposed binary name (foo-1.2.3-darwin-arm64
# -> foo, cli-x86_64-unknown-linux-gnu -> cli).
clean_stem() {  # "$raw" -> clean name
    local s=$1 a
    s=${s##*/}
    s=${s%%-[0-9]*}
    for a in x86_64 aarch64 arm64 amd64 linux darwin macos windows freebsd unknown; do
        s=${s%%[-_]$a*}
    done
    [ -n "$s" ] || s=${1##*/}
    printf '%s\n' "$s"
}

# Print the plan: raw executable files -> bin/<clean>, one (src key) pair per
# line; non-executables are left as extras (unlinked under .orig).
single_plan() {  # "$base"
    local base=$1 f b clean
    for f in "$base"/*; do
        [ -e "$f" ] || continue
        b=$(basename "$f")
        [ -x "$f" ] || continue
        clean=$(clean_stem "$b")
        printf '%s|%s\n' "$b" "bin/$clean"
    done
}

main() { run_leaf single-bin single-bin single_plan "$@"; }

main "$@"
